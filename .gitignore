# Secrets: the API key lives in .env, never in git (.env.example is the template)
.env
.env.*
!.env.example

# The repo-local toolchain `task setup` provisions
.venv/

# Everything the template generates outside agents/: the keyed engine cache
# (out/cache/), downloaded toolchains (out/toolchains/), match archives,
# training runs made with --env, the C wire test binary
out/

# Per-agent build products (task build / task train); the sources are yours
agents/*/out/
agents/*/target/
agents/*/gen/

# The Rust wire reference's cargo build
reference/rust-wire/target/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# OS
.DS_Store
