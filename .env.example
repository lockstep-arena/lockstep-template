# Only needed for `task upload`. Create a key from your account settings at
# https://lockstep.it — a plain user key, no special role.
LOCKSTEP_API_KEY=

# Optional: point the template (and lockstep-train) at a different CDN —
# e.g. a local mirror. Default: https://dl.lockstep.it
# LOCKSTEP_CDN_URL=
