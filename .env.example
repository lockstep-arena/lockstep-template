# Only needed for `task upload`. Create a key from your account settings at
# https://lockstep.it — a plain user key, no special role. `task doctor`
# reports whether it is set.
LOCKSTEP_API_KEY=

# Optional: point the template (and lockstep-train) at a different platform
# API and CDN — e.g. a local `task everything-dev` stack while developing an
# environment. Defaults: https://api.lockstep.it and https://dl.lockstep.it
# LOCKSTEP_API_URL=
# LOCKSTEP_CDN_URL=
