# Only needed for `task upload`. Create a key on the Authorization page at
# https://lockstep.it — a plain user key, no special role. `task doctor`
# reports whether it is set.
LOCKSTEP_API_KEY=

# Advanced: a self-hosted Lockstep. Leave both unset to use the public
# platform (https://api.lockstep.it and https://dl.lockstep.it).
# LOCKSTEP_API_URL=
# LOCKSTEP_CDN_URL=
